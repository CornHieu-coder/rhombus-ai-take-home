RHOMBUS_BASE_URL=https://rhombusai.com
RHOMBUS_STORAGE_STATE=auth/rhombus.json
# Exact original evidence project name; the journey uses a separate project.
RHOMBUS_PROJECT_NAME=Rhombus QA Drift Exercise
RHOMBUS_S3_BUCKET=
RHOMBUS_S3_REGION=ap-southeast-2
# Existing object key is this prefix + baseline.csv; include a trailing slash if needed.
RHOMBUS_S3_PREFIX=rhombus-qa/
RHOMBUS_GCS_BUCKET=
# Ignored local JSON key, required only when creating a journey-project destination.
RHOMBUS_GCS_SERVICE_ACCOUNT_JSON_PATH=secrets/gcs-service-account.json
RHOMBUS_API_BASE_URL=
# Live UI journey opt-in; default runs skip it.
RHOMBUS_RUN_PROVISIONING_JOURNEY=0
RHOMBUS_JOURNEY_PROJECT_NAME=Rhombus QA Playwright Journey
# 0 verifies configuration; 1 also requires actual S3/GCS delivery evidence.
RHOMBUS_JOURNEY_VERIFY_DELIVERY=0
RHOMBUS_CLOUD_CDP_URL=http://127.0.0.1:9333
RHOMBUS_JOURNEY_GRACE_SECONDS=180
# Optional overrides; empty values use the default test-results directory and python.
RHOMBUS_JOURNEY_EVIDENCE_DIR=
RHOMBUS_PYTHON=
# Set to 1 only after allowing an automatic attempt in existing-project checks.
RHOMBUS_EXPECT_SCHEDULE_HISTORY=0
